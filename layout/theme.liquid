<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}

    {% unless settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'home.css' | asset_url | stylesheet_tag }}
    {{ 'home.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}
    {{ content_for_header }}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.CMP = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        currency: {{ cart.currency.iso_code | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    <div class="cmp-live-region visually-hidden" aria-live="polite" aria-atomic="true" data-live-region></div>
  </body>
</html>
