{% liquid
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_badge = card_product.metafields.cmp.badge.value
  assign card_image = card_product.featured_media.preview_image
%}

<article class="cmp-product-card">
  <a class="cmp-product-card__media" href="{{ card_product.url }}" aria-label="Ver {{ card_product.title | escape }}">
    {% if card_image %}
      {{ card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 640px) 50vw, 100vw', alt: card_image.alt | default: card_product.title }}
    {% else %}
      <div class="cmp-product-card__placeholder">
        {% render 'icon', name: 'foot' %}
        <span>Imagen próximamente</span>
      </div>
    {% endif %}
    {% if card_badge != blank %}
      <span class="cmp-product-card__badge">{{ card_badge }}</span>
    {% elsif card_variant.compare_at_price > card_variant.price %}
      <span class="cmp-product-card__badge">Oferta</span>
    {% elsif card_product.available == false %}
      <span class="cmp-product-card__badge cmp-product-card__badge--muted">Agotado</span>
    {% endif %}
  </a>

  <div class="cmp-product-card__content">
    {% if show_vendor and card_product.vendor != blank %}
      <p class="cmp-product-card__vendor">{{ card_product.vendor }}</p>
    {% endif %}
    <h3 class="cmp-product-card__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
    {% if card_product.metafields.cmp.short_description.value != blank %}
      <p class="cmp-product-card__description">{{ card_product.metafields.cmp.short_description.value | escape }}</p>
    {% endif %}
    {% render 'price', product: card_product %}

    {% if quick_add %}
      {% if card_product.has_only_default_variant and card_product.available %}
        <form method="post" action="{{ routes.cart_add_url }}" data-product-form>
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="button button--secondary button--full" type="submit">Agregar</button>
          <p class="form-error" data-form-error hidden></p>
        </form>
      {% else %}
        <a class="button button--secondary button--full" href="{{ card_product.url }}">
          {% if card_product.available %}Elegir opciones{% else %}Ver producto{% endif %}
        </a>
      {% endif %}
    {% endif %}
  </div>
</article>
