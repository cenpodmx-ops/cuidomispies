{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}

  :root {
    --cmp-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --cmp-font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --cmp-page-width: {{ settings.page_width }}px;
    --cmp-page-margin: {{ settings.page_margin }}px;
    --cmp-teal: {{ settings.color_primary }};
    --cmp-teal-dark: {{ settings.color_primary_dark }};
    --cmp-sage: {{ settings.color_secondary }};
    --cmp-beige: {{ settings.color_accent }};
    --cmp-ivory: {{ settings.color_background }};
    --cmp-graphite: {{ settings.color_text }};
    --cmp-white: #ffffff;
    --cmp-muted: #667471;
    --cmp-border: #dfe4df;
    --cmp-success: #2d7554;
    --cmp-warning: #a85d20;
    --cmp-danger: #a43d2e;
    --cmp-radius-sm: 10px;
    --cmp-radius: 16px;
    --cmp-radius-lg: 24px;
    --cmp-shadow-sm: 0 2px 12px rgb(36 48 47 / 8%);
    --cmp-shadow: 0 18px 50px rgb(36 48 47 / 12%);
    --cmp-transition: 180ms ease;

    /* === Aliases — variables usadas por los CSS de página (home/product/collection/cart/routine-finder)
       Mapean las variables --color-*, --radius-*, --shadow-* a los --cmp-* de marca.
       Sin ellos, el diseño visual de las páginas colapsa (sin bordes, sombras, colores). === */
    --color-primary: var(--cmp-teal);
    --color-primary-dark: var(--cmp-teal-dark);
    --color-secondary: var(--cmp-sage);
    --color-secondary-contrast: var(--cmp-graphite);
    --color-accent: var(--cmp-beige);
    --color-background: var(--cmp-ivory);
    --color-background-soft: color-mix(in srgb, var(--cmp-beige) 38%, var(--cmp-ivory));
    --color-surface: #ffffff;
    --color-surface-alt: color-mix(in srgb, var(--cmp-sage) 14%, var(--cmp-ivory));
    --color-text: var(--cmp-graphite);
    --color-text-muted: var(--cmp-muted);
    --color-border: var(--cmp-border);
    --color-success: var(--cmp-success);
    --color-warning: var(--cmp-warning);
    --color-danger: var(--cmp-danger);
    --font-heading-family: var(--cmp-font-heading);
    --font-body-family: var(--cmp-font-body);
    --radius-card: var(--cmp-radius);
    --radius-small: var(--cmp-radius-sm);
    --radius-button: var(--cmp-radius-sm);
    --shadow-soft: var(--cmp-shadow-sm);
    --shadow-card: var(--cmp-shadow);
  }
{% endstyle %}
