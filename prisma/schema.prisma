// CuidoMisPies — Prisma schema
// Modela el catálogo MVP del blueprint: 8 categorías, 25 SKU, 9 kits, FAQs, rutinas y reviews.
// Los campos `cmp.*` equivalen a los metafields/metaobjects de Shopify.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// CATEGORÍAS (necesidades del consumidor)
// ───────────────────────────────────────────────
model Category {
  id            String    @id @default(cuid())
  slug          String    @unique // hongos, diabetes, piel-seca-talones...
  name          String    // "Hongos"
  shortName     String    // nombre corto para tarjetas/nav
  tagline       String    // "Uñas, piel y calzado"
  description   String    // explicación breve para H1
  longText      String    // bloque educativo
  iconKey       String    // key del icono lucide usado en la UI
  accentColor   String    // color de acento de la categoría
  heroImage     String?   // imagen hero de la categoría
  order         Int       @default(0)
  isPriority    Boolean   @default(false) // categorías prioritarias
  products      Product[]
  kits          Kit[]
  faqs          Faq[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────────────────────────────
// PRODUCTOS (25 SKU del MVP)
// ───────────────────────────────────────────────
model Product {
  id              String    @id @default(cuid())
  sku             String    @unique // HON-01, DIA-01...
  slug            String    @unique
  title           String    // "Solución antifúngica para uñas"
  shortBenefit    String    // cmp.short_benefit - beneficio para cards
  description     String    // descripción larga
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  careLevel       String    // Diario / Intensivo / Extra intensivo
  howToUse        String    // cmp.how_to_use - uso según etiqueta
  benefits        String    // cmp.benefits - 3-4 beneficios (separados por \n)
  precautions     String    // cmp.precautions
  whenToConsult   String    // cmp.when_to_consult
  badge           String?   // Más vendido / Recomendado / Nuevo
  routineStep     String?   // "Paso 1", "Paso 2", etc.
  activeIngredient String?  // ingrediente activo si aplica
  presentation    String    // "15 ml", "60 g", "1 par"
  brand           String    @default("CuidoMisPies")
  price           Float     // precio en MXN
  compareAtPrice Float?    // precio de comparación (para ofertas)
  rating          Float     @default(4.7)
  reviewCount     Int       @default(0)
  isHero          Boolean   @default(false) // producto héroe
  isBestseller    Boolean   @default(false)
  isDiscoverable  Boolean   @default(false) // producto de descubrimiento
  isReorderable   Boolean   @default(true)  // recompra
  needs           String    // necesidades asociadas, separadas por coma
  images          String    // JSON array de URLs de imágenes
  relatedKitId    String?   // cmp.related_kit
  crossSellIds    String?   // cmp.cross_sell - IDs separados por coma
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kitItems        KitItem[]
  reviews         Review[]
}

// ───────────────────────────────────────────────
// KITS (9 configuraciones de rutina)
// ───────────────────────────────────────────────
model Kit {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String    // "Kit Antihongos - Uñas + Calzado"
  shortBenefit    String
  description     String
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  routineName     String    // nombre de la rutina
  routineSummary  String    // "Uñas + piel + calzado + complemento"
  savingsLabel    String    // "Ahorra $120" o "Rutina completa"
  steps           String    // JSON con pasos de la rutina explicados
  howToCombine    String    // cómo combinar los productos
  price           Float
  compareAtPrice  Float?    // suma individual
  rating          Float     @default(4.8)
  reviewCount     Int       @default(0)
  isFeatured      Boolean   @default(false)
  isAnchor        Boolean   @default(false) // kit ancla de precio
  heroImage       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           KitItem[]
}

model KitItem {
  id          String   @id @default(cuid())
  kitId       String
  kit         Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  stepNumber  Int      // paso de la rutina
  stepLabel   String   // "Paso 1 - Uñas"
  quantity    Int      @default(1)
}

// ───────────────────────────────────────────────
// REVIEWS (social proof)
// ───────────────────────────────────────────────
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int      // 1-5
  title       String
  body        String
  isVerified   Boolean @default(true)
  createdAt   DateTime @default(now())
}

// ───────────────────────────────────────────────
// FAQs (metaobject FAQ)
// ───────────────────────────────────────────────
model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   // "general", "hongos", "diabetes"...
  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id])
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ───────────────────────────────────────────────
// RUTINAS (metaobject Routine) - para QR y postventa
// ───────────────────────────────────────────────
model Routine {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  need            String
  shortDescription String
  heroImage       String?
  stepsJson       String   // JSON con pasos
  precautions     String
  whenToConsult   String
  qrContent       String
  createdAt       DateTime @default(now())
}
