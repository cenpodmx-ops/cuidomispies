[
  {
    "name": "theme_info",
    "theme_name": "CuidoMisPies",
    "theme_version": "1.0.0",
    "theme_author": "CuidoMisPies",
    "theme_documentation_url": "https://github.com/cenpodmx-ops/cuidomispies",
    "theme_support_url": "https://github.com/cenpodmx-ops/cuidomispies/issues"
  },
  {
    "name": "Marca",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logotipo" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "color", "id": "color_primary", "label": "Teal principal", "default": "#176B6B" },
      { "type": "color", "id": "color_primary_dark", "label": "Teal oscuro", "default": "#105858" },
      { "type": "color", "id": "color_secondary", "label": "Verde salvia", "default": "#A9C5B5" },
      { "type": "color", "id": "color_accent", "label": "Beige", "default": "#E9DDCE" },
      { "type": "color", "id": "color_background", "label": "Marfil", "default": "#FAFAF7" },
      { "type": "color", "id": "color_text", "label": "Grafito", "default": "#24302F" }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "default": "work_sans_n7", "label": "Títulos" },
      { "type": "font_picker", "id": "type_body_font", "default": "work_sans_n4", "label": "Texto" }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 50, "unit": "px", "label": "Ancho máximo", "default": 1300 },
      { "type": "range", "id": "page_margin", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Margen lateral", "default": 20 }
    ]
  },
  {
    "name": "Comercio",
    "settings": [
      { "type": "range", "id": "free_shipping_threshold", "min": 0, "max": 2000, "step": 1, "unit": "$", "label": "Monto para envío gratis", "default": 999 },
      { "type": "checkbox", "id": "cart_drawer_enabled", "label": "Abrir carrito lateral al agregar", "default": true }
    ]
  },
  {
    "name": "Contacto y redes",
    "settings": [
      { "type": "url", "id": "whatsapp_url", "label": "URL de WhatsApp" },
      { "type": "text", "id": "support_email", "label": "Correo de atención" },
      { "type": "url", "id": "instagram_url", "label": "Instagram" },
      { "type": "url", "id": "facebook_url", "label": "Facebook" }
    ]
  }
