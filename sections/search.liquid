<section class="cmp-search-page section-spacing">
  <div class="page-width">
    <header class="section-heading section-heading--center"><p class="eyebrow">Busca por producto o necesidad</p><h1>Buscar</h1></header>
    <form class="cmp-search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchPageInput">Buscar</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Ej. resequedad, juanete, urea…" required>
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button button--primary" type="submit">Buscar</button>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="empty-state"><h2>No encontramos resultados para “{{ search.terms | escape }}”</h2><p>Prueba con una necesidad o con el nombre del producto.</p><a class="button button--secondary" href="{{ routes.all_products_collection_url }}">Ver todos los productos</a></div>
      {% else %}
        <p class="cmp-search-page__count">{{ search.results_count }} resultados para “{{ search.terms | escape }}”</p>
        {% paginate search.results by 20 %}
          <div class="cmp-search-grid">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                {% render 'product-card', card_product: result, quick_add: true %}
              {% else %}
                <article class="cmp-content-card">
                  <p class="eyebrow">{% if result.object_type == 'article' %}Artículo{% else %}Página{% endif %}</p>
                  <h2><a href="{{ result.url }}">{{ result.title }}</a></h2>
                  <p>{{ result.content | strip_html | truncatewords: 28 }}</p>
                  <a class="text-link" href="{{ result.url }}">Leer más {% render 'icon', name: 'chevron' %}</a>
                </article>
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Búsqueda principal", "settings": [] }
{% endschema %}
