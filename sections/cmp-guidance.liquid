<section class="cmp-guidance section-spacing cmp-section--soft">
  <div class="page-width">
    <div class="section-heading section-heading--center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
    <div class="cmp-guidance__grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <div>{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label }} {% render 'icon', name: 'chevron' %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Orientación y confianza",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Cuidado informado" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Acompañamiento más allá del producto" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Información práctica para construir hábitos y reconocer cuándo pedir ayuda." }
  ],
  "blocks": [
    { "type": "item", "name": "Elemento", "settings": [
      { "type": "select", "id": "icon", "label": "Ícono", "default": "professional", "options": [{ "value": "professional", "label": "Profesional" }, { "value": "shield", "label": "Escudo" }, { "value": "heart", "label": "Corazón" }, { "value": "drop", "label": "Gota" }] },
      { "type": "text", "id": "title", "label": "Título", "default": "Orientación responsable" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Explicamos para qué sirve cada producto, cómo usarlo y sus precauciones." },
      { "type": "text", "id": "link_label", "label": "Texto del enlace" },
      { "type": "url", "id": "link", "label": "Enlace" }
    ] }
  ],
  "presets": [{ "name": "Orientación y confianza", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
