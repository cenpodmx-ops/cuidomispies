<section class="cmp-hero cmp-hero--with-image{% if section.settings.image == blank %} cmp-hero--default-banner{% endif %}">
  <picture class="cmp-hero__picture">
    {% if section.settings.image != blank %}
      {% if section.settings.mobile_image != blank %}
        <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
      {% endif %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900, 1300, 1700, 2200', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.heading }}
    {% else %}
      <img src="{{ 'cmp-banner-premium.jpg' | asset_url }}" width="1672" height="941" loading="eager" alt="Crema humectante, desodorante bicida y Urea 20 Gel de CuidoMisPies">
    {% endif %}
  </picture>

  <div class="page-width cmp-hero__inner">
    <div class="cmp-hero__content">
      {% if section.settings.image != blank %}
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% endif %}
      <h1{% if section.settings.image == blank %} class="cmp-hero__embedded-title"{% endif %}>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<div class="cmp-hero__text rte{% if section.settings.image == blank %} cmp-hero__embedded-text{% endif %}">{{ section.settings.text }}</div>{% endif %}
      <div class="cmp-hero__actions">
        {% if section.settings.primary_label != blank %}<a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
      {% if section.settings.microcopy != blank %}<p class="cmp-hero__microcopy">{% render 'icon', name: 'shield' %}{{ section.settings.microcopy }}</p>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada principal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Bienestar y cuidado diario" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Cuida tus pies con claridad y confianza" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Soluciones organizadas por necesidad, rutinas sencillas y orientación para elegir mejor.</p>" },
    { "type": "text", "id": "primary_label", "label": "Botón principal", "default": "Encontrar mi solución" },
    { "type": "url", "id": "primary_link", "label": "Enlace principal" },
    { "type": "text", "id": "secondary_label", "label": "Botón secundario", "default": "Explorar por necesidad" },
    { "type": "url", "id": "secondary_link", "label": "Enlace secundario" },
    { "type": "text", "id": "microcopy", "label": "Texto de confianza", "default": "Envíos a todo México · Compra segura · Respaldo profesional" },
    { "type": "image_picker", "id": "image", "label": "Imagen horizontal" },
    { "type": "image_picker", "id": "mobile_image", "label": "Imagen para celular" }
  ],
  "presets": [{ "name": "Portada principal" }]
}
{% endschema %}
