<section class="cmp-needs section-spacing">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>

    <div class="cmp-needs__grid">
      {% for block in section.blocks %}
        <a class="cmp-need-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="cmp-need-card__visual">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.image.alt | default: block.settings.title }}
            {% else %}
              {% render 'icon', name: block.settings.icon %}
            {% endif %}
          </div>
          <div><h3>{{ block.settings.title }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}<span>Explorar {% render 'icon', name: 'chevron' %}</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compra por necesidad",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compra según lo que necesitas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Qué quieres cuidar hoy?" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Explora productos y rutinas organizados para que sea más fácil decidir." }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Necesidad",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Hongos" },
        { "type": "text", "id": "text", "label": "Texto breve" },
        { "type": "select", "id": "icon", "label": "Ícono", "default": "foot", "options": [
          { "value": "foot", "label": "Pie" }, { "value": "drop", "label": "Gota" }, { "value": "heart", "label": "Corazón" }, { "value": "shield", "label": "Escudo" }, { "value": "sparkles", "label": "Destellos" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Imagen opcional" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Compra por necesidad", "blocks": [{ "type": "need" }, { "type": "need" }, { "type": "need" }, { "type": "need" }] }]
}
{% endschema %}
