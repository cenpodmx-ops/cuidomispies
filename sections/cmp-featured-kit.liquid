{% assign kit = section.settings.product %}
<section class="cmp-kit-feature section-spacing">
  <div class="page-width">
    <div class="cmp-kit-feature__card">
      <div class="cmp-kit-feature__media">
        {% if kit != blank and kit.featured_image %}
          {{ kit.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: kit.featured_image.alt | default: kit.title }}
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          <div class="cmp-kit-feature__placeholder">{% render 'icon', name: 'sparkles' %}<span>Aquí aparecerá la fotografía del kit</span></div>
        {% endif %}
      </div>
      <div class="cmp-kit-feature__content">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{% if kit != blank %}{{ kit.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
        <p>{% if kit != blank %}{{ kit.metafields.cmp.short_description.value | default: kit.description | strip_html | truncate: 220 }}{% else %}{{ section.settings.text }}{% endif %}</p>
        {% if kit != blank %}{% render 'price', product: kit %}{% endif %}
        <ul role="list"><li>{% render 'icon', name: 'heart' %}Pasos fáciles de seguir</li><li>{% render 'icon', name: 'shield' %}Productos pensados para usarse juntos</li><li>{% render 'icon', name: 'truck' %}Envíos en México</li></ul>
        <a class="button button--primary" href="{% if kit != blank %}{{ kit.url }}{% else %}{{ section.settings.link }}{% endif %}">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kit destacado",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Una rutina completa" },
    { "type": "text", "id": "heading", "label": "Título alternativo", "default": "Kit de cuidado destacado" },
    { "type": "textarea", "id": "text", "label": "Texto alternativo", "default": "Reúne los pasos esenciales en una sola compra." },
    { "type": "product", "id": "product", "label": "Producto tipo kit" },
    { "type": "image_picker", "id": "image", "label": "Imagen alternativa" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver el kit" },
    { "type": "url", "id": "link", "label": "Enlace alternativo" }
  ],
  "presets": [{ "name": "Kit destacado" }]
}
{% endschema %}
