{{ 'cart-page.css' | asset_url | stylesheet_tag }}

<section class="cmp-cart-page section-spacing">
  <div class="page-width">
    <div class="section-heading"><p class="eyebrow">Tu selección</p><h1>Carrito</h1></div>

    {% if cart.item_count == 0 %}
      <div class="empty-state">
        {% render 'icon', name: 'cart' %}
        <h2>Tu carrito está vacío</h2>
        <p>Explora soluciones por necesidad o usa el recomendador para encontrar un punto de partida.</p>
        <div class="cmp-cart-empty__actions"><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Ver productos</a><a class="button button--secondary" href="{{ pages['encuentra-tu-rutina'].url | default: '/pages/encuentra-tu-rutina' }}">Encontrar mi rutina</a></div>
      </div>
    {% else %}
      <form class="cmp-cart-page__grid" action="{{ routes.cart_url }}" method="post">
        <div class="cmp-cart-page__items">
          {% for item in cart.items %}
            <article class="cmp-cart-page__item">
              <a class="cmp-cart-page__image" href="{{ item.url }}">
                {% if item.image %}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '120px', alt: item.image.alt | default: item.product.title }}{% endif %}
              </a>
              <div class="cmp-cart-page__details">
                <div>
                  <a class="cmp-cart-page__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
                  {% for property in item.properties %}
                    {% assign property_first = property.first | slice: 0 %}
                    {% unless property.last == blank or property_first == '_' %}<p>{{ property.first }}: {{ property.last }}</p>{% endunless %}
                  {% endfor %}
                </div>
                <a class="cmp-cart-page__remove" href="{{ item.url_to_remove }}">Eliminar</a>
                <label class="cmp-cart-page__quantity">Cantidad
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Cantidad de {{ item.product.title | escape }}">
                </label>
              </div>
              <strong>{{ item.final_line_price | money }}</strong>
            </article>
          {% endfor %}
          <button class="button button--secondary" type="submit" name="update">Actualizar carrito</button>
        </div>

        <aside class="cmp-cart-summary">
          <h2>Resumen</h2>
          <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          {% if cart.cart_level_discount_applications.size > 0 %}
            {% for discount in cart.cart_level_discount_applications %}<div class="cmp-cart-summary__discount"><span>{{ discount.title }}</span><strong>−{{ discount.total_allocated_amount | money }}</strong></div>{% endfor %}
          {% endif %}
          <p>Envío e impuestos se calculan al finalizar la compra.</p>
          {% if settings.free_shipping_threshold > 0 %}
            {% assign free_shipping_cents = settings.free_shipping_threshold | times: 100 %}
            {% assign shipping_remaining = free_shipping_cents | minus: cart.total_price %}
            <div class="cmp-cart-summary__shipping">
              {% if shipping_remaining > 0 %}Te faltan <strong>{{ shipping_remaining | money }}</strong> para envío gratis.{% else %}<strong>¡Tu pedido tiene envío gratis!</strong>{% endif %}
            </div>
          {% endif %}
          <button class="button button--primary button--full" type="submit" name="checkout">Ir a pago seguro</button>
          <ul role="list"><li>{% render 'icon', name: 'shield' %}Pago protegido por Shopify</li><li>{% render 'icon', name: 'truck' %}Seguimiento de tu pedido</li></ul>
        </aside>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Carrito principal", "settings": [] }
{% endschema %}
