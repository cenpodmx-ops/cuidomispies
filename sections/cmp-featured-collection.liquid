<section class="cmp-featured section-spacing{% if section.settings.soft_background %} cmp-section--soft{% endif %}">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">Ver todo {% render 'icon', name: 'chevron' %}</a>{% endif %}
    </div>

    {% liquid
      assign manual_count = 0
      for product_index in (1..4)
        assign product_key = 'product_' | append: product_index
        if section.settings[product_key] != blank
          assign manual_count = manual_count | plus: 1
        endif
      endfor
    %}

    {% if manual_count > 0 %}
      <div class="cmp-product-grid">
        {% for product_index in (1..4) %}
          {% assign product_key = 'product_' | append: product_index %}
          {% assign card_product = section.settings[product_key] %}
          {% if card_product != blank %}{% render 'product-card', card_product: card_product, quick_add: true %}{% endif %}
        {% endfor %}
      </div>
    {% elsif section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="cmp-product-grid">
        {% for card_product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', card_product: card_product, quick_add: true %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cmp-editor-note"><strong>Conecta una colección</strong><span>Desde el editor de Shopify selecciona aquí la colección que quieres mostrar.</span></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Selección CuidoMisPies" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos para tu rutina" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "header", "content": "Selección manual opcional" },
    { "type": "paragraph", "content": "Si eliges productos aquí, tendrán prioridad sobre la colección." },
    { "type": "product", "id": "product_1", "label": "Producto 1" },
    { "type": "product", "id": "product_2", "label": "Producto 2" },
    { "type": "product", "id": "product_3", "label": "Producto 3" },
    { "type": "product", "id": "product_4", "label": "Producto 4" },
    { "type": "range", "id": "products_to_show", "label": "Productos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "soft_background", "label": "Fondo suave", "default": false }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
