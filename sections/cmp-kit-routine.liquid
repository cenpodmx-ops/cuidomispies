{% liquid
  assign routine_steps = product.metafields.cmp.routine_steps.value
  assign kit_products = product.metafields.cmp.kit_products.value
%}

{% if routine_steps != blank or kit_products != blank %}
  <section class="cmp-kit-routine section-spacing cmp-section--soft">
    <div class="page-width">
      {% if routine_steps != blank %}
        <div class="section-heading section-heading--center"><p class="eyebrow">Cómo usar tu kit</p><h2>Una rutina, paso a paso</h2></div>
        <ol class="cmp-kit-steps">
          {% for step in routine_steps %}<li><span>{{ forloop.index }}</span><p>{{ step }}</p></li>{% endfor %}
        </ol>
      {% endif %}
      {% if kit_products != blank %}
        <div class="section-heading"><p class="eyebrow">Incluye</p><h2>Productos dentro de este kit</h2></div>
        <div class="cmp-product-grid">
          {% for kit_product in kit_products limit: 4 %}{% render 'product-card', card_product: kit_product, quick_add: false %}{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .cmp-kit-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 0 0 4rem; padding: 0; list-style: none; }
  .cmp-kit-steps li { padding: 1.25rem; border-radius: var(--radius-card); background: #fff; }
  .cmp-kit-steps span { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; border-radius: 50%; background: var(--color-primary); color: #fff; font-weight: 800; }
  .cmp-kit-steps p { margin-bottom: 0; color: var(--color-text-muted); }
  @media (max-width: 749px) { .cmp-kit-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 449px) { .cmp-kit-steps { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Rutina del kit",
  "enabled_on": { "templates": ["product"] },
  "settings": []
}
{% endschema %}
